{
  "cli": {
    "version": ">= 22.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "node": "24.9.0",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "preview": {
      "node": "24.9.0",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://grrind-back.fly.dev"
      }
    },
    "production": {
      "node": "24.9.0",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://grrind-back.fly.dev"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6801890245"
      }
    }
  }
}
