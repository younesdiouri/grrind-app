{
  "expo": {
    "name": "grrind-app",
    "slug": "grrind-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "grrindapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "app.grrind",
      "infoPlist": {
        "NSHealthShareUsageDescription": "GRRIND lit les séances de sport déjà enregistrées dans Santé — leur durée, leur distance, leur dénivelé, tes calories actives et ta fréquence cardiaque moyenne — pour les convertir en expérience et faire progresser ton personnage. GRRIND ne lit rien d'autre, n'écrit jamais dans Santé, et ne partage ces données avec personne.",
        "NSHealthUpdateUsageDescription": "GRRIND n'écrit jamais dans Santé. Cette autorisation est exigée par iOS dès que l'app demande un accès à Santé, mais GRRIND ne l'utilise jamais pour modifier tes données.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.background-delivery": true
      }
    },
    "android": {
      "package": "app.grrind",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e095e243-7be5-4c60-bdca-da2596548e0e"
      }
    },
    "owner": "younesdiouri"
  }
}
