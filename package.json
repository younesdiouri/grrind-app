{
  "name": "grrind-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.10",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~57.0.12",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.10",
    "expo-crypto": "~57.0.1",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-linking": "~57.0.5",
    "expo-notifications": "~57.0.13",
    "expo-router": "~57.0.12",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-react-jsx": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@types/babel__core": "^7.20.5",
    "@types/node": "~26.2.0",
    "@types/react": "~19.2.2",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios --device",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "previews": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/use-module-hooks.ts scripts/build-previews.ts",
    "previews:check": "npm run previews && git diff --exit-code --stat previews && test -z \"$(git status --porcelain previews)\"",
    "test": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/use-module-hooks.ts \"src/**/*.test.ts\"",
    "api:pull": "curl -sfL -o api/openapi.yaml https://raw.githubusercontent.com/younesdiouri/grrind-back/main/openapi.yaml",
    "api:generate": "npx --yes openapi-typescript@7.13.0 api/openapi.yaml -o src/api/schema.d.ts",
    "api:check": "npm run api:pull && npm run api:generate && git diff --exit-code --stat api/openapi.yaml src/api/schema.d.ts"
  },
  "private": true
}
